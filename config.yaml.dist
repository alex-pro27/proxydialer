routes:
  -
    proxy: 127.0.0.1:58580
    use: true
    exclude:
      - "*.microsoft.com"
    auth:
      username: "route_user"
      password: "route_pass"
    rules:
      "SPB":
        priority: 1
      "US (Microsoft, GitHub, OpenAI)":
        priority: 2
proxies:
  # standalone-прокси — слушает напрямую
  -
    dialer: 127.0.0.1:7492
    proxy: 127.0.0.1:6969
    protocol: socks5
    username: user         # плоский формат аутентификации (старый)
    password: pass
    use: true
    exclude:
      - '*.yandex.ru'
  # routing-only прокси — без dialer, используется только через routes
  -
    name: SPB
    proxy: 127.0.0.1:6969
    protocol: socks5
    use: true
    auth:                  # вложенный формат аутентификации (новый)
      username: "user"
      password: "pass"
    exclude:
      - '*.cloud-effem.ru'
      - '*.gosuslugi.ru'
      - '10.248.1.79'
      - '*.dzen.ru'
      - '*.yandex.ru'
      - '*.vk.com'
      - '*.mail.ru'
  -
    name: US (Microsoft, GitHub, OpenAI)
    proxy: 127.0.0.1:6066
    protocol: http
    use: true
    only:
      - '*.microsoft.com'
      - '*.github.com'
      - '*.openai.com'
      - '*.anthropic.com'
      - '*.speedtest.net'
      - '*.visualstudio.com'
      - '*.vscode.dev'
      - '*.githubusercontent.com'
      - '*.visual-studio.com'
      - '*.chatgpt.com'
      - 'gemini.google.com'
      - '*.youtube.com'
      - '*.youtu.be'
      - '*.googlevideo.com'
      - 'yt.be'
      - 'ytimg.com'
      - 'ggpht.com'
      - 'gvt1.com'
      - 'youtube-nocookie.com'
      - 'youtube-ui.l.google.com'
      - 'youtubeembeddedplayer.googleapis.com'
      - 'yt3.googleusercontent.com'
      - 'youtube.googleapis.com'
      - 'youtubei.googleapis.com'
      - 'yt-video-upload.l.google.com'
      - 'wide-youtube.l.google.com'
      - 'youtubei.googleapis.com'
      - 'aistudio.google.com'
      - '*.doubleclick.net'
      - 'console.cloud.google.com'
      - '*.claude.ai'
